generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  STUDENT
  ADMIN
}
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}
enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}
enum ExchangeStatus {
  PROPOSED
  ACCEPTED
  COMPLETED
  CANCELLED
}
model User {
  id String @id @default(cuid())
  email String @unique
  emailVerified DateTime?
  name String?
  image String?
  displayName String?
  department String?
  year Int?
  role Role @default(STUDENT)
  preferredMeetup String?
  rulesAcceptedAt DateTime?
  suspendedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  listings Listing[]
  saved SavedListing[]
  reports Report[] @relation("Reporter")
  resolvedReports Report[] @relation("Resolver")
  contacts ContactEvent[]
  purchases Exchange[] @relation("Buyer")
  sales Exchange[] @relation("Seller")
  uploads Upload[]
  adminActions AdminAuditLog[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  nameZh String
  nameEn String
  icon String
  listings Listing[]
}
model Listing {
  id String @id @default(cuid())
  sellerId String
  title String
  description String @db.Text
  categoryId String
  condition Condition
  priceNtd Int?
  isFree Boolean @default(false)
  openToTrade Boolean @default(false)
  meetupLocation String
  campuses String[]
  status ListingStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  soldAt DateTime?
  hiddenAt DateTime?
  seller User @relation(fields: [sellerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  images ListingImage[]
  saved SavedListing[]
  reports Report[]
  contacts ContactEvent[]
  exchanges Exchange[]
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([sellerId])
}
model ListingImage {
  id String @id @default(cuid())
  listingId String
  url String
  thumbUrl String
  alt String
  position Int
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([listingId, position])
}
model SavedListing {
  userId String
  listingId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@id([userId, listingId])
}
model Report {
  id String @id @default(cuid())
  listingId String
  reporterId String
  reason String
  details String?
  status String @default("OPEN")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  resolvedById String?
  listing Listing @relation(fields: [listingId], references: [id])
  reporter User @relation("Reporter", fields: [reporterId], references: [id])
  resolvedBy User? @relation("Resolver", fields: [resolvedById], references: [id])
  @@index([status, createdAt])
}
model ContactEvent {
  id String @id @default(cuid())
  listingId String
  buyerId String
  createdAt DateTime @default(now())
  listing Listing @relation(fields: [listingId], references: [id])
  buyer User @relation(fields: [buyerId], references: [id])
  @@index([buyerId, createdAt])
}
model ExchangePoint {
  id String @id
  campus String
  nameZh String
  nameEn String
  recommendedStart String @default("12:00")
  recommendedEnd String @default("18:00")
  mapUrl String?
  verified Boolean @default(false)
  active Boolean @default(true)
  exchanges Exchange[]
}
model Exchange {
  id String @id @default(cuid())
  listingId String
  buyerId String
  sellerId String
  pointId String
  scheduledAt DateTime
  status ExchangeStatus @default(PROPOSED)
  buyerArrivedAt DateTime?
  sellerArrivedAt DateTime?
  buyerCompletedAt DateTime?
  sellerCompletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listing Listing @relation(fields: [listingId], references: [id])
  buyer User @relation("Buyer", fields: [buyerId], references: [id])
  seller User @relation("Seller", fields: [sellerId], references: [id])
  point ExchangePoint @relation(fields: [pointId], references: [id])
  @@index([buyerId, status])
  @@index([sellerId, status])
}
model Upload {
  id String @id @default(cuid())
  userId String
  key String @unique
  mimeType String
  bytes Int
  url String?
  thumbUrl String?
  completedAt DateTime?
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt])
}
model RateLimitEvent {
  id String @id @default(cuid())
  userId String
  action String
  createdAt DateTime @default(now())
  @@index([userId, action, createdAt])
}

model AdminAuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  targetType String
  targetId String
  targetLabel String
  reason String?
  before Json
  after Json
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id])
  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
