# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace
# Local development only: automatically start bundled PostgreSQL if stopped.
DEV_DATABASE_MANAGED=true
# Local development only: persist images under .dev-data/media without R2.
# Production always requires the S3 variables below.
LOCAL_IMAGE_STORAGE=true
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAINS=gms.tcu.edu.tw
ADMIN_EMAILS=
# Cloudflare R2: keep all credentials on the server
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=campus-marketplace
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
SERVER_EMAIL_CONTACT=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Local demo seed only; never enable for a live student marketplace
SEED_DEMO=false
