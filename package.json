    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "demo:images": "tsx scripts/generate-demo.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1145.0",
