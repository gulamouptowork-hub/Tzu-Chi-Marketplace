    "@prisma/client": "^6.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@swc/core": "1.15.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "19.2.8",
